# Copy to .env and adjust for local dev.
# docker-compose reads these via env_file.

# --- Database ---
POSTGRES_USER=docverify
POSTGRES_PASSWORD=docverify
POSTGRES_DB=docverify
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- API ---
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# --- Storage ---
# Where uploaded files land on disk. Mounted as a volume by docker-compose.
STORAGE_DIR=/data/storage

# --- Upload limits ---
MAX_UPLOAD_BYTES=20971520   # 20 MiB
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/jpg,image/tiff
