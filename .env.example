# Copy to .env and adjust for local dev.
# docker-compose reads these via env_file.

# --- Database ---
POSTGRES_USER=docverify
POSTGRES_PASSWORD=docverify
POSTGRES_DB=docverify
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- API ---
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-a-long-random-string

# Default password for `python -m seeds.seed_users` (dev only).
SEED_DEFAULT_PASSWORD=changeme-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# --- Storage ---
# Where uploaded files land on disk. Mounted as a volume by docker-compose.
STORAGE_DIR=/data/storage

# --- Upload limits ---
MAX_UPLOAD_BYTES=20971520   # 20 MiB
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/jpg,image/tiff

# --- Production deploy ---
# Set this to your public domain to enable Caddy + Let's Encrypt TLS in the
# `docker-compose.prod.yml` overlay. Leave blank for local HTTP-only testing.
DEPLOY_DOMAIN=

# Optional. When set (e.g. by Fly.io / Render / Railway / Heroku), it
# overrides POSTGRES_HOST/PORT/USER/PASSWORD/DB above.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
